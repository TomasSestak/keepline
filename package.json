{
  "name": "keepline",
  "version": "0.1.0",
  "description": "Typed WebSocket client that keeps the line up: reconnection with jittered backoff, heartbeats and half-open detection, schema validation, reconnect-surviving subscriptions, and a real observability stream. ESM-first, zero dependencies, with React 19 bindings.",
  "keywords": [
    "websocket",
    "websockets",
    "react",
    "react-hooks",
    "usewebsocket",
    "reconnect",
    "reconnecting-websocket",
    "heartbeat",
    "realtime",
    "typescript",
    "esm",
    "standard-schema",
    "zod",
    "observability"
  ],
  "license": "MIT",
  "author": "Tom\u00e1\u0161 \u0160est\u00e1k",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomasSestak/keepline.git"
  },
  "bugs": {
    "url": "https://github.com/TomasSestak/keepline/issues"
  },
  "homepage": "https://github.com/TomasSestak/keepline#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./compat": {
      "import": {
        "types": "./dist/compat/index.d.ts",
        "default": "./dist/compat/index.js"
      },
      "require": {
        "types": "./dist/compat/index.d.cts",
        "default": "./dist/compat/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./sentry": {
      "import": {
        "types": "./dist/sentry/index.d.ts",
        "default": "./dist/sentry/index.js"
      },
      "require": {
        "types": "./dist/sentry/index.d.cts",
        "default": "./dist/sentry/index.cjs"
      }
    },
    "./logger": {
      "import": {
        "types": "./dist/logger/index.d.ts",
        "default": "./dist/logger/index.js"
      },
      "require": {
        "types": "./dist/logger/index.d.cts",
        "default": "./dist/logger/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "MIGRATION.md", "CHANGELOG.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "size": "bun run build && size-limit",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run build",
    "prepublishOnly": "bun run build",
    "release": "bun run build && changeset publish"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.9",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "happy-dom": "^15.11.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "zod": "^3.24.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "name": "core (keepline)",
      "path": "dist/index.js",
      "limit": "5 kB",
      "ignore": ["react"]
    },
    {
      "name": "react (keepline/react)",
      "path": "dist/react/index.js",
      "limit": "7 kB",
      "ignore": ["react"]
    }
  ],
  "packageManager": "bun@1.3.10"
}
